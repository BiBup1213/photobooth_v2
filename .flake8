[flake8]
max-line-length = 90

# Black compatibility:
# - E203: whitespace before ':'
# - W503: line break before binary operator
extend-ignore =
    E203,
    W503

per-file-ignores =
    __init__.py:F401

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    .mypy_cache,
    .pytest_cache
