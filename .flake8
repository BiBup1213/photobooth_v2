[flake8]
# Align with Black (line-length) + small buffer
max-line-length = 100

# Sinnvolle Defaults
extend-ignore =
    E203,  # whitespace before ':' (Black-kompatibel)
    W503   # line break before binary operator (Black-kompatibel)

# Optional, aber oft angenehm (reduziert Noise)
per-file-ignores =
    __init__.py:F401  # "imported but unused" in package exports

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    .mypy_cache,
    .pytest_cache
